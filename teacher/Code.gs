ifier.","expected":"Le chiffre d’affaires augmente de 10 %, de 1 500 à 1 650 k€, mais le résultat net recule de 100 à 48 k€. La marge commerciale baisse légèrement, de 600 à 594 k€, malgré la croissance des ventes : chaque euro vendu contribue donc moins à couvrir les autres charges. Les stocks augmentent de 40 k€ et les créances clients de 55 k€. Ces ressources immobilisées dans le cycle d’exploitation limitent la conversion du résultat en trésorerie. Les dettes fournisseurs et fiscales ou sociales progressent toutefois de 34 k€, ce qui finance partiellement ce besoin. Le flux d’exploitation de 32 k€ ne couvre pas les investissements de 120 k€. Le financement net de 50 k€ limite la baisse de trésorerie à 38 k€, de 140 à 102 k€. Des remises plus fortes ou une hausse des coûts d’achat pourraient expliquer la dégradation de la marge : les documents ne prouvent pas ces causes. Il faut vérifier le détail des prix, volumes et coûts, ainsi que l’ancienneté des créances et les prévisions de rotation des stocks, avant d’arrêter une décision.","rubric":["1 point : trois constats chiffrés exacts croisant résultat, bilan et flux.","1 point : hypothèse explicitement présentée comme telle et cohérente avec les chiffres.","1 point : deux informations complémentaires pertinentes à vérifier."],"format":"Rédigez une réponse personnelle structurée. Appuyez-vous sur les données ; aucune phrase exacte n’est imposée.","hints":["Commencez par un constat chiffré.","Présentez l’explication comme une hypothèse si les documents ne démontrent pas la cause.","Terminez par une information à vérifier ou une limite."],"points":3},{"id":"e16","type":"open","prompt":"Proposez deux actions RH justifiées. Pour chacune : constat, mécanisme financier, condition ou coût, indicateur.","expected":"Former à la politique de remise et à la marge peut contribuer à préserver la marge commerciale : vérifier d’abord le mix et le coût de formation ; suivre la marge par commande. Clarifier la coordination vente-facturation-relance peut faciliter l’encaissement : vérifier les litiges et les échéances ; suivre les créances échues. D’autres actions argumentées sont recevables.","rubric":["1 point : deux actions RH pertinentes et reliées aux constats du cas.","1 point : mécanisme financier expliqué pour chacune, sans gain inventé.","1 point : condition ou coût et indicateur de suivi pour chaque action."],"format":"Rédigez une réponse personnelle structurée. Appuyez-vous sur les données ; aucune phrase exacte n’est imposée.","hints":["Commencez par un constat chiffré.","Présentez l’explication comme une hypothèse si les documents ne démontrent pas la cause.","Terminez par une information à vérifier ou une limite."],"points":3}]}];
/** EMLV – installation des neuf validations. Aucun email n’est envoyé.
 * Les réponses et le suivi restent privés dans le compte de l’enseignant.
 * Lancer installerEMLV() une fois; relancer reprend sans doublons.
 */
const APPLICATION = 'https://azdezed.github.io/emlv-chapitre1-prepa-dst/';
function installerEMLV() {
 const props=PropertiesService.getScriptProperties();
 let sheetId=props.getProperty('sheetId');
 let book=sheetId?SpreadsheetApp.openById(sheetId):SpreadsheetApp.create('EMLV · Prépa DST · Suivi privé des validations');
 if(!sheetId){sheetId=book.getId();props.setProperty('sheetId',sheetId);const first=book.getSheets()[0];first.setName('Mode emploi');first.getRange(1,1,7,2).setValues([
 ['EMLV · Suivi privé','Chapitre 1 · Prépa DST'],['Réception','La présence d’une réponse dans ce fichier fait foi, pas un clic dans l’application.'],['Calculs','Le score objectif porte sur QCM et calculs lisibles ; un format ambigu reste à revoir.'],['Argumentation','Lecture obligatoire par l’enseignant, selon la grille du cas.'],['Compétence','La décision finale reste à renseigner après lecture et vérification.'],['Promotions','DRH1, DRH2, MSID1 ou autre groupe explicitement déclaré.'],['Données','Identifiant étudiant/code et promotion. Aucun email collecté automatiquement.']]);first.setColumnWidth(1,210);first.setColumnWidth(2,800);first.getRange('A1:B1').setBackground('#008078').setFontColor('white').setFontWeight('bold');first.getRange('A1:B7').setWrap(true);first.setFrozenRows(1);
 const suivi=book.insertSheet('Suivi');suivi.appendRow(['Horodatage','Promotion','Identifiant étudiant','Compétence','Cas','Réponse reçue (ID)','Score objectif','Maximum objectif évalué','Formats à revoir','Argumentation à lire','Validation enseignant','Commentaire enseignant','Éditer la réponse','Synthèse calculs']);suivi.setFrozenRows(1);suivi.getRange(1,1,1,14).setBackground('#008078').setFontColor('#ffffff').setFontWeight('bold');suivi.setColumnWidths(1,14,170);suivi.setColumnWidth(14,600);suivi.getRange(1,1,1,14).createFilter();
 const catalogue=book.insertSheet('Catalogue');catalogue.appendRow(['Compétence','Cas','Formulaire étudiants','Modifier formulaire','Correction et grille']);catalogue.setFrozenRows(1);catalogue.getRange(1,1,1,5).setBackground('#008078').setFontColor('white').setFontWeight('bold');catalogue.setColumnWidths(1,5,260);
 }
 const config={forms:{}};
 for(const c of VALIDATIONS){
  const key='form:'+c.module;let formId=props.getProperty(key);let form;
  if(formId){form=FormApp.openById(formId);}else{
   form=FormApp.create('EMLV · Validation · '+c.title,true);props.setProperty(key,form.getId());
   form.setDescription('Travail individuel · Documents et calculatrice autorisés · Intelligence artificielle interdite.\nDocuments visuels : '+APPLICATION+'#validation/'+c.module+'\n'+c.context);
   form.setConfirmationMessage('Votre travail a été reçu. Une réception ne vaut pas validation de la compétence. Les réponses ouvertes seront lues par l’enseignant. Correction détaillée : '+APPLICATION+'#correction-validation/'+c.id);
   form.setAllowResponseEdits(true);form.setShowLinkToRespondAgain(false);form.setCollectEmail(false);
   const promotion=form.addListItem().setTitle('Promotion').setRequired(true).setChoiceValues(['DRH1','DRH2','MSID1','Autre promotion']);
   const code=form.addTextItem().setTitle('Identifiant étudiant / code communiqué en cours').setRequired(true).setHelpText('Utilisez le même identifiant pour chaque validation.');
   for(const s of c.statements){const text=[s.columns.join(' | ')+' · unité : '+s.unit,...s.rows.map(r=>r.label+' : '+r.values.join(' | '))].join('\n');form.addSectionHeaderItem().setTitle(s.title).setHelpText(text);}
   const mapping=[];
   c.questions.forEach((q,i)=>{let item;if(q.type==='choice'){item=form.addMultipleChoiceItem().setChoiceValues(q.choices.map(o=>o.label));}else if(q.type==='open'){item=form.addParagraphTextItem();}else{item=form.addTextItem();}
    item.setTitle((i+1)+'. '+q.prompt).setRequired(true).setHelpText(q.format+(q.type==='number'?' Ne mettez pas de calcul dans cette case ; écrivez le résultat dans l’unité demandée. Virgule/point acceptés, espaces de milliers acceptés. En cas de doute, le format sera relu.':''));
    mapping.push({itemId:item.getId(),qid:q.id});if(q.type==='number'){form.addParagraphTextItem().setTitle((i+1)+'. Méthode : données, formule et opérations').setRequired(true).setHelpText('Indiquez les lignes retenues et expliquez votre calcul. Cette partie est relue par l’enseignant.');}
   });
   form.setDestination(FormApp.DestinationType.SPREADSHEET,sheetId);
   props.setProperty('map:'+form.getId(),JSON.stringify({caseId:c.id,module:c.module,promotionId:promotion.getId(),codeId:code.getId(),mapping}));
   ScriptApp.newTrigger('receptionEMLV').forForm(form).onFormSubmit().create();
   book.getSheetByName('Catalogue').appendRow([c.module,c.title,form.getPublishedUrl(),form.getEditUrl(),c.questions.map(q=>q.prompt+'\n'+(q.type==='number'?q.expected+' '+q.unit:q.type==='choice'?q.choices.find(o=>o.id===q.expected).label:q.expected)+'\n'+(q.rubric||[]).join(' ; ')).join('\n\n')]);
  }
  config.forms[c.module]={url:form.getPublishedUrl()};
 }
 props.setProperty('publicConfig',JSON.stringify(config));
 console.log('SUIVI PRIVÉ : '+book.getUrl());console.log('CONFIGURATION PUBLIQUE À INTÉGRER : '+JSON.stringify(config));
 return config;
}
function nombreEMLV(raw,unit){let s=String(raw==null?'':raw).trim().replace(/[−–]/g,'-');if(!s)return {ok:false};const m=s.match(/\s*(%|k€|M€|M\$|€|euros?|millions?|milliers?)\s*$/i);if(m){const norm=x=>x.toLowerCase().replace(/euros?/,'€');if(norm(m[1])!==norm(unit))return {ok:false};s=s.slice(0,m.index).trim();}if(!/^[+-]?(?:\d+|\d{1,3}(?:[ \u00a0\u202f]\d{3})+)(?:[.,]\d+)?$/.test(s))return {ok:false};return {ok:true,value:Number(s.replace(/[ \u00a0\u202f]/g,'').replace(',','.'))};}
function celluleEMLV(v){const s=String(v==null?'':v);return /^[=+\-@]/.test(s)?"'"+s:s;}
function receptionEMLV(e){
 if(!e||!e.response||!e.source)throw new Error('Cette fonction s’exécute par le déclencheur de remise du formulaire.');
 const lock=LockService.getScriptLock();lock.waitLock(30000);
 try{const props=PropertiesService.getScriptProperties(),map=JSON.parse(props.getProperty('map:'+e.source.getId())),c=VALIDATIONS.find(c=>c.id===map.caseId),book=SpreadsheetApp.openById(props.getProperty('sheetId')),sheet=book.getSheetByName('Suivi'),response=e.response;
 const received={};response.getItemResponses().forEach(r=>received[r.getItem().getId()]=r.getResponse());
 let score=0,max=0,formats=0,open=c.questions.filter(q=>q.type==='number').length,details=[];
 for(const m of map.mapping){const q=c.questions.find(q=>q.id===m.qid),raw=received[m.itemId];if(q.type==='open'){open++;details.push(q.id+': argumentation à lire');continue;}if(q.type==='choice'){max+=q.points||1;const expected=q.choices.find(o=>o.id===q.expected).label;const good=raw===expected;if(good)score+=q.points||1;details.push(q.id+': '+(good?'correct':'à revoir'));}else{const n=nombreEMLV(raw,q.unit);if(!n.ok){formats++;details.push(q.id+': format à revoir, aucune erreur attribuée automatiquement');}else{max+=q.points||1;const good=Math.abs(n.value-q.expected)<=.5*Math.pow(10,-(q.precision==null?2:q.precision))+1e-9;if(good)score+=q.points||1;details.push(q.id+': '+(good?'correct':'résultat à revoir'));}}}
 const row=[response.getTimestamp(),celluleEMLV(received[map.promotionId]),celluleEMLV(received[map.codeId]),c.module,c.id,response.getId(),score,max,formats,open,'À lire','',response.getEditResponseUrl(),details.join(' ; ')];
 const idCol=sheet.getLastRow()>1?sheet.getRange(2,6,sheet.getLastRow()-1,1).getValues().flat():[];const existing=idCol.indexOf(response.getId());if(existing>=0){const old=sheet.getRange(existing+2,11,1,2).getValues()[0];row[10]='Remise modifiée · à relire';row[11]=old[1];sheet.getRange(existing+2,1,1,row.length).setValues([row]);}else{sheet.appendRow(row);}sheet.getRange(2,1,Math.max(1,sheet.getLastRow()-1),14).setWrap(true);
 }finally{lock.releaseLock();}
}
function afficherConfigurationEMLV(){const p=PropertiesService.getScriptProperties();console.log(p.getProperty('publicConfig'));console.log(SpreadsheetApp.openById(p.getProperty('sheetId')).getUrl());}

function finaliserRecetteEMLV(){
 const p=PropertiesService.getScriptProperties();
 const f=FormApp.openById(p.getProperty('form:sujet-blanc'));
 const c=VALIDATIONS.find(c=>c.module==='sujet-blanc');
 f.setDescription('Travail individuel · Documents et calculatrice autorisés · Intelligence artificielle interdite.\nDocuments visuels : '+APPLICATION+'#exam\n'+c.context);
 SpreadsheetApp.openById(p.getProperty('sheetId')).setSpreadsheetTimeZone('Europe/Paris');
 console.log('Recette : lien sujet blanc corrigé ; horodatage Europe/Paris ; '+ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='receptionEMLV').length+' déclencheurs de réception.');
}

